{
  "regions": ["sin1"],
  "buildCommand": "npm run build && node scripts/prepare-vercel.mjs",
  "functions": {
    "api/invitation.ts": { "includeFiles": "dist/invitation-shell.html" }
  },
  "crons": [
    { "path": "/api/keep-alive", "schedule": "17 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; frame-src 'self' https://maps.google.com https://www.google.com https://www.youtube-nocookie.com; connect-src 'self' https://immygqswhukepdrxlxvb.supabase.co; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/invitation" },
    { "source": "/index.html", "destination": "/api/invitation" },
    { "source": "/dashboard/:path*", "destination": "/invitation-shell.html" },
    { "source": "/studio/:path*", "destination": "/invitation-shell.html" },
    { "source": "/checkin/:path*", "destination": "/invitation-shell.html" }
  ]
}
