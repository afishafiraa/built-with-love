# Apps Script Web App URL (see apps-script/Code.gs — Deploy > New deployment > Web app)
VITE_SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXX/exec
# Shared secret, must match SECRET in Code.gs
VITE_SHEETS_TOKEN=ganti-dengan-rahasia
# Password gate for /dashboard
VITE_ADMIN_PIN=xxxx
# Cloudinary unsigned upload (asset upload)
VITE_CLOUDINARY_CLOUD=your-cloud
VITE_CLOUDINARY_PRESET=wedding_unsigned
# Couple WhatsApp number for notifications, international format without +
VITE_WA_NUMBER=6281234567890
