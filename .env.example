# Server-only. Set these in Vercel; never prefix them with VITE_.
SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXX/exec
SHEETS_TOKEN=ganti-dengan-token-random
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$salt$hash
SESSION_SECRET=ganti-dengan-random-minimal-32-karakter

# Browser-visible and optional.
VITE_WA_NUMBER=6281234567890
# Set true only for visual development with plain `npm run dev` (no API writes).
VITE_DEMO_MODE=true
