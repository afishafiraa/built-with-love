# Production database. Server-only; never prefix these with VITE_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_ganti-dengan-secret-key
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$salt$hash
SESSION_SECRET=ganti-dengan-random-minimal-32-karakter
# Used automatically by Vercel Cron as a Bearer token.
CRON_SECRET=ganti-dengan-random-minimal-32-karakter
# Optional fallback when the endpoint is called from a VPS.
KEEPALIVE_SECRET=ganti-dengan-random-minimal-32-karakter

# Set true only for visual development with plain `npm run dev` (no API writes).
VITE_DEMO_MODE=true
