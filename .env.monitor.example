# Copy to .env.monitor on the VPS only. Never commit real values.
MONITOR_URL=https://your-wedding-domain.example
KEEPALIVE_SECRET=replace-with-a-random-value-of-at-least-32-characters
ALERT_TO_EMAIL=you@example.com
ALERT_FROM_EMAIL=you@example.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=you@example.com
ALERT_SMTP_PASSWORD=replace-with-a-Gmail-app-password
MONITOR_STATE_FILE=/opt/wedding-invitation/monitor-state.json
MONITOR_REMINDER_HOURS=24
